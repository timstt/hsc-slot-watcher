# Copy to .env and fill in. The .env file is not committed to git.

# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Which slots are interesting ---
# LATEST_TIME=10:30
# LATEST_INCLUSIVE=true        # false = strictly earlier than LATEST_TIME
# DATE_FROM=2026-11-15         # optional
# DATE_TO=2026-11-30           # optional
# MIN_LEAD_MINUTES=120         # ignore slots starting less than 2 h away

# --- Service centers (Chernihiv only by default) ---
# Pryluky has id 143. Add deliberately: each center is ~16 more requests per cycle.
# The name is user-facing (it appears in the Telegram message), hence Ukrainian.
# SERVICE_CENTERS=[{"id":142,"name":"Чернігів"}]

# --- Schedule (windowed mode: the site session lives 15 min) ---
# INTERVAL_SECONDS=60          # pause between cycles; small, to fit more into a window
# INTERVAL_JITTER=0.3
# RUSH_ENABLED=false           # frequent checks of a new edge date (disabled)
# RUSH_START=05:58
# RUSH_END=06:20
# RUSH_INTERVAL_SECONDS=60
# NIGHT_ENABLED=true
# NIGHT_START=00:00
# NIGHT_END=05:30
# NIGHT_INTERVAL_SECONDS=1200
# Which dates to read per cycle:
#   full   -- every date each cycle
#   tiered -- the nearest NEAR_DATES each cycle, the rest FAR_PER_CYCLE per cycle
# In the RUSH window only EDGE_DATES edge dates and just-opened ones are read.
# SCAN_MODE=full
# NEAR_DATES=6
# FAR_PER_CYCLE=2
# EDGE_DATES=1
# NOTIFY_NEW_DATES=false       # true -- also notify about slots on a just-opened edge date
# Site limit: at 7-9 s we hit 429 by the ~10th request, at 20-30 s a full pass of
# 15 dates went through with no refusals. Do not set below 20 s.
# REQUEST_PAUSE_MIN=20.0       # pause between requests, seconds
# REQUEST_PAUSE_MAX=30.0

# --- Notifications ---
# QUIET_ENABLED=true           # during quiet hours slots arrive silently
# QUIET_START=00:00
# QUIET_END=06:00
# HEARTBEAT_TIME=09:00
# SERVICE_REPEAT_HOURS=4       # service messages no more than once every N hours
# STALE_MINUTES=30
# BLOCK_PAUSE_MINUTES=60       # pause after 403/429/captcha

# --- Browser (the same for login and the monitor) ---
# BROWSER_CHANNEL=chrome       # empty = Playwright's bundled Chromium
# BROWSER_HEADLESS=false       # the site blocks headless, do not enable
# BROWSER_START_MINIMIZED=true
# USER_AGENT=

# --- Fallback channel: email (off until all four are set) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=               # Gmail App Password, not the main password
# EMAIL_TO=you@gmail.com
